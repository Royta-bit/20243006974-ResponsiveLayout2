<?xml version="1.0" encoding="utf-8"?>
<!-- ============ Part 1: LinearLayout + layout_weight ============ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- 内部垂直布局：占满整个屏幕宽度 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ① 顶部标题：权重 1 -->
        <TextView
            android:id="@+id/tvLab1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:text="Lab 1" />

        <!-- ② 副标题：权重 1 -->
        <TextView
            android:id="@+id/tvResponsiveLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:text="Responsive Layout 1" />

        <!-- ③ 一排四个 TextView：内层横向 LinearLayout，权重 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FF0000"
                android:textColor="#FFFFFF"
                android:text="This" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#0000FF"
                android:textColor="#FFFFFF"
                android:text="is" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#673AB7"
                android:textColor="#FFFFFF"
                android:text="my" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFFF00"
                android:textColor="#000000"
                android:text="first" />
        </LinearLayout>

        <!-- ④ 中间大区块：权重 2（高度是其它区块的两倍） -->
        <TextView
            android:id="@+id/tvAndroidApplication"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:text="Android Application" />

        <!-- ⑤ 两个按钮：内层横向 LinearLayout，权重 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnChange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="16dp"
                android:text="Change"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6750A4" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="16dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:backgroundTint="#6750A4" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>