<?xml version="1.0" encoding="utf-8"?>
<!-- 平板 sw600dp：保持上一题单列垂直布局，增大 padding、字号、色块高度适配大屏 -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="32dp">

    <!-- 内部垂直布局：占满整个屏幕宽度 -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- ① 顶部标题：权重 1 -->
        <TextView
            android:id="@+id/tvLab1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:text="Lab 1"
            android:textSize="24sp" />

        <!-- ② 副标题：权重 1 -->
        <TextView
            android:id="@+id/tvResponsiveLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:background="#FFFFFF"
            android:textColor="#000000"
            android:text="Responsive Layout 1"
            android:textSize="22sp" />

        <!-- ③ 一排四个 TextView：内层横向 LinearLayout，权重 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FF0000"
                android:textColor="#FFFFFF"
                android:text="This"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#0000FF"
                android:textColor="#FFFFFF"
                android:text="is"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#673AB7"
                android:textColor="#FFFFFF"
                android:text="my"
                android:textSize="18sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:gravity="center"
                android:background="#FFFF00"
                android:textColor="#000000"
                android:text="first"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- ④ 中间大区块：权重 2（高度是其它区块的两倍） -->
        <TextView
            android:id="@+id/tvAndroidApplication"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:background="#000000"
            android:textColor="#FFFFFF"
            android:text="Android Application"
            android:textSize="24sp" />

        <!-- ⑤ 两个按钮：内层横向 LinearLayout，权重 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnChange"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="24dp"
                android:text="Change"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#6750A4" />

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_margin="24dp"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:backgroundTint="#6750A4" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>